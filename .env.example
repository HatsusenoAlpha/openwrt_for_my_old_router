# Copy to .env.local and fill locally. Never commit the filled file.
DEEPSEEK_API_KEY=

# Codex custom provider. The endpoint must implement the Responses API.
DEEPSEEK_MODEL=
DEEPSEEK_RESPONSES_BASE_URL=

# Optional platform homes.
CODEX_HOME=
DSH_HOME=

# Historical remote build host used by the plans.
OPENWRT_REMOTE_HOST=xps13
OPENWRT_REMOTE_SOURCE=/home/chenmo/Software/openwrt/lede
