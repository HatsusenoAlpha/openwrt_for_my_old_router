# Optional environment file. Install as:
#   <task-home>/build.env

AUTOBUILD_JOBS=4
AUTOBUILD_DOWNLOAD_JOBS=8
CONTINUE_ON_ERROR=0
KEEP_SOURCE_STATE=0

# Example:
# DDNS_PROVIDER_PACKAGES="ddns-scripts-cloudflare"
DDNS_PROVIDER_PACKAGES=""
EXTRA_PACKAGES=""

# Proxy used for Git, Make downloads, curl and Go modules.
AUTOBUILD_SOCKS_PROXY=socks5://192.168.100.1:1080
