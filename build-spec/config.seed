# ============================================================================
# OpenWrt / ImmortalWrt 25.12.x build seed for FastRhino R66S (RK3568)
# ----------------------------------------------------------------------------
# 用法：make menuconfig 先按下面注释逐项核对（符号名可能随版本略有差异），
#      再把本文件内容合并进 .config（或 scripts/diffconfig .config config.seed）。
# 注意：DEVICE 符号名必须通过 `make menuconfig` 里实际选择确认一次。
# ============================================================================

# ---- target / subtarget / device ----
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_fastrhino_r66s=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# ---- image generation (与已验证的官方新镜像一致) ----
# p1 = 64 MiB (kernel + dtb + boot.scr, ext4), p2 = 896 MiB (squashfs + f2fs overlay)
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=896
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
# SquashFS: 1 MiB block + xz（与旧/新固件一致：block_size=1 MiB, compression=xz）
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
CONFIG_TARGET_SQUASHFS_COMPRESSION_XZ=y

# ---- kernel / system ----
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_IKCONFIG=y
CONFIG_KERNEL_IKCONFIG_PROC=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a55"
CONFIG_TARGET_OPTIONS=""
CONFIG_TARGET_BOARD="rockchip"
CONFIG_TARGET_SUBTARGET="armv8"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_generic"

# ---- 网络驱动：R66S 的两口是 PCIe RTL8125 (r8125)，必须包含 ----
CONFIG_PACKAGE_kmod-r8125=y

# ---- 必需基础包 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_losetup=y

# ---- 代理 / 插件（版本见 packages-new.txt；alterId 需 ssr-plus >= 196-r10 或 186-8） ----
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_xray-core=y
# 若希望用 Mihomo 引擎（Clash.Meta，支持 VMess alterId>0）：
# CONFIG_PACKAGE_mihomo=y

# ---- 用户既有插件（可选，按需保留） ----
CONFIG_PACKAGE_luci-app-samba=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-unblockmusic=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-vsftpd=y
CONFIG_PACKAGE_luci-app-qbittorrent-simple=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-app-ipsec-server=y
CONFIG_PACKAGE_luci-app-openvpn-server=y
CONFIG_PACKAGE_luci-app-pptp-server=y
CONFIG_PACKAGE_luci-app-aliyundrive-webdav=y
CONFIG_PACKAGE_luci-app-adbyby-plus=y

# ---- 调试便利（可选） ----
# CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_iperf3=y
